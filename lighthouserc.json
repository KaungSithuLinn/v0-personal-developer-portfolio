{
  "ci": {
    "collect": {
      "url": [
        "https://v0-personal-developer-portfolio-psi-blush.vercel.app/en",
        "https://v0-personal-developer-portfolio-psi-blush.vercel.app/zh",
        "https://v0-personal-developer-portfolio-psi-blush.vercel.app/ms"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new",
        "skipAudits": ["uses-http2", "is-on-https"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*vercel\\.app/.*",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "categories:seo": ["warn", { "minScore": 0.9 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
            "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
